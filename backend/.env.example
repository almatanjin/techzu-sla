APP_NAME="Techzu SLA"
APP_ENV=local
# Generated by: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Origin of the React app; the only origin allowed by CORS.
FRONTEND_URL=http://localhost:5173

# MySQL service from docker-compose.yml (local-only credentials).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=techzu_sla
DB_USERNAME=techzu
DB_PASSWORD=secret

# The API is stateless (Bearer tokens), so no server-side sessions.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum personal access token expiration in minutes (10080 = 7 days).
SANCTUM_TOKEN_EXPIRATION=10080

# Mailpit catches all local mail: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@techzu-sla.test"
MAIL_FROM_NAME="${APP_NAME}"
